@@ -0,0 +1,66 @@
+import React, { useEffect, useState } from 'react';
+import Button from 'antd/lib/button';
+import { AimOutlined, EyeOutlined, VerticalAlignBottomOutlined } from '@ant-design/icons';
+import { Canvas3d } from 'cvat-canvas3d-wrapper';
+
+interface CuboidScreen {
+    clientID: number;
+    x: number;
+    y: number;
+}
+
+// Floats over the active (hovered) cuboid: keep only the points around it, or drop it onto the ground.
+export default function IsolatePointsButton({ canvas }: { canvas: Canvas3d }): JSX.Element | null {
+    const [screen, setScreen] = useState<CuboidScreen | null>(null);
+    const [isolatedID, setIsolatedID] = useState<number | null>(null);
+
+    useEffect(() => {
+        const target = canvas.html().perspective;
+        const listener = (event: Event): void => setScreen((event as CustomEvent<CuboidScreen | null>).detail);
+        target.addEventListener('canvas.activecuboidscreen', listener);
+        return () => target.removeEventListener('canvas.activecuboidscreen', listener);
+    }, [canvas]);
+
+    const isolate = (clientID: number | null): void => {
+        canvas.isolateObject(clientID);
+        setIsolatedID(clientID);
+    };
+
+    const { offsetLeft, offsetTop } = canvas.html().perspective;
+    return (
+        <>
+            {screen && (
+                <div
+                    className='cvat-isolate-points-button'
+                    style={{ left: offsetLeft + screen.x, top: offsetTop + screen.y }}
+                >
+                    <Button
+                        size='small'
+                        icon={isolatedID === screen.clientID ? <EyeOutlined /> : <AimOutlined />}
+                        onClick={() => isolate(isolatedID === screen.clientID ? null : screen.clientID)}
+                    >
+                        {isolatedID === screen.clientID ? 'Hiện tất cả points' : 'Chỉ giữ points quanh cuboid'}
+                    </Button>
+                    <Button
+                        size='small'
+                        icon={<VerticalAlignBottomOutlined />}
+                        onClick={() => canvas.snapObjectToGround(screen.clientID)}
+                    >
+                        Đặt xuống mặt đất
+                    </Button>
+                </div>
+            )}
+            {isolatedID !== null && screen?.clientID !== isolatedID && (
+                <Button
+                    size='small'
+                    type='primary'
+                    className='cvat-isolate-points-reset'
+                    icon={<EyeOutlined />}
+                    onClick={() => isolate(null)}
+                >
+                    Hiện tất cả points
+                </Button>
+            )}
+        </>
+    );
+}
