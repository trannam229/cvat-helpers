+import React, { useEffect, useState } from 'react';
+import { useSelector } from 'react-redux';
+import Slider from 'antd/lib/slider';
+import Text from 'antd/lib/typography/Text';
+import { Canvas3d } from 'cvat-canvas3d-wrapper';
+import { CombinedState } from 'reducers';
+
+const BRIGHTNESS_KEY = 'cvat:point-cloud-brightness';
+const SIZE_KEY = 'cvat:point-cloud-size';
+
+function readNumber(key: string, fallback: number): number {
+    const value = Number(localStorage.getItem(key));
+    return Number.isFinite(value) && value > 0 ? value : fallback;
+}
+
+// Point brightness (scales point colours, so it shows on clouds with rgb) and point size, kept per browser.
+export default function PointCloudAppearance(): JSX.Element {
+    const canvas = useSelector((state: CombinedState) => state.annotation.canvas.instance);
+    const [brightness, setBrightness] = useState(() => readNumber(BRIGHTNESS_KEY, 1));
+    const [size, setSize] = useState(() => readNumber(SIZE_KEY, 1));
+
+    useEffect(() => {
+        if (canvas instanceof Canvas3d) {
+            canvas.configure({ pointBrightness: brightness, pointSize: size });
+        }
+        localStorage.setItem(BRIGHTNESS_KEY, String(brightness));
+        localStorage.setItem(SIZE_KEY, String(size));
+    }, [canvas, brightness, size]);
+
+    const percent = (value?: number): string => `${Math.round((value ?? 0) * 100)}%`;
+    return (
+        <>
+            <Text type='secondary'>Point brightness</Text>
+            <Slider
+                className='cvat-appearance-point-brightness-slider'
+                min={0.5}
+                max={3}
+                step={0.1}
+                value={brightness}
+                onChange={setBrightness}
+                tooltip={{ formatter: percent }}
+            />
+            <Text type='secondary'>Point size</Text>
+            <Slider
+                className='cvat-appearance-point-size-slider'
+                min={0.5}
+                max={5}
+                step={0.1}
+                value={size}
+                onChange={setSize}
+                tooltip={{ formatter: percent }}
+            />
+        </>
+    );
+}
