@@ -0,0 +1,75 @@
+import React, { useState } from 'react';
+import { useDispatch, useSelector } from 'react-redux';
+import Modal from 'antd/lib/modal';
+import InputNumber from 'antd/lib/input-number';
+import message from 'antd/lib/message';
+import { CopyOutlined } from '@ant-design/icons';
+
+import CVATTooltip from 'components/common/cvat-tooltip';
+import { copyCuboidsToFrameAsync } from 'actions/annotation-actions';
+import { ObjectState, ShapeType } from 'cvat-core-wrapper';
+import { CombinedState } from 'reducers';
+import { shallowEqual, ThunkDispatch } from 'utils/redux';
+
+interface Props {
+    disabled: boolean;
+}
+
+function CopyCuboidsControl({ disabled }: Props): JSX.Element {
+    const dispatch = useDispatch<ThunkDispatch>();
+    const { frame, frameNumbers, cuboidCount } = useSelector((state: CombinedState) => ({
+        frame: state.annotation.player.frame.number,
+        frameNumbers: state.annotation.job.frameNumbers,
+        cuboidCount: state.annotation.annotations.states.filter((objectState: ObjectState) => (
+            objectState.shapeType === ShapeType.CUBOID && !objectState.outside
+        )).length,
+    }), shallowEqual);
+    const [open, setOpen] = useState(false);
+    const [targetFrame, setTargetFrame] = useState<number | null>(null);
+
+    const valid = targetFrame !== null && targetFrame !== frame && frameNumbers.includes(targetFrame);
+    const openDialog = (): void => {
+        const next = frameNumbers.find((frameNumber: number) => frameNumber > frame);
+        setTargetFrame(next ?? frameNumbers.findLast((frameNumber: number) => frameNumber < frame) ?? null);
+        setOpen(true);
+    };
+
+    const iconClassName = `cvat-copy-cuboids-control${disabled || !cuboidCount ? ' cvat-disabled-canvas-control' : ''}`;
+    return (
+        <>
+            {disabled || !cuboidCount ? (
+                <CopyOutlined className={iconClassName} />
+            ) : (
+                <CVATTooltip title='Copy all cuboids of this frame to another frame' placement='right'>
+                    <CopyOutlined className={iconClassName} onClick={openDialog} />
+                </CVATTooltip>
+            )}
+            <Modal
+                title={`Copy ${cuboidCount} cuboid(s) from frame ${frame}`}
+                open={open}
+                okText='Copy'
+                okButtonProps={{ disabled: !valid }}
+                onCancel={() => setOpen(false)}
+                onOk={async () => {
+                    if (!valid || targetFrame === null) return;
+                    const copied = await dispatch(copyCuboidsToFrameAsync(frame, targetFrame));
+                    setOpen(false);
+                    if (copied) message.success(`Copied ${copied} cuboid(s) to frame ${targetFrame}`);
+                }}
+                destroyOnClose
+            >
+                <label htmlFor='cvat-copy-cuboids-target'>Target frame </label>
+                <InputNumber
+                    id='cvat-copy-cuboids-target'
+                    min={frameNumbers[0]}
+                    max={frameNumbers[frameNumbers.length - 1]}
+                    value={targetFrame}
+                    onChange={(value: number | null) => setTargetFrame(value)}
+                    autoFocus
+                />
+            </Modal>
+        </>
+    );
+}
+
+export default React.memo(CopyCuboidsControl);
