+import React, { useEffect, useState } from 'react';
+import { Canvas3d } from 'cvat-canvas3d-wrapper';
+
+// Crosshair and key hints while the perspective view is in fly mode.
+export default function FlyModeOverlay({ canvas }: { canvas: Canvas3d }): JSX.Element | null {
+    const [enabled, setEnabled] = useState(false);
+
+    useEffect(() => {
+        const target = canvas.html().perspective;
+        const listener = (event: Event): void => setEnabled((event as CustomEvent<{ enabled: boolean }>).detail.enabled);
+        target.addEventListener('canvas.flymode', listener);
+        return () => target.removeEventListener('canvas.flymode', listener);
+    }, [canvas]);
+
+    if (!enabled) return null;
+    return (
+        <>
+            <div className='cvat-fly-mode-crosshair' />
+            <div className='cvat-fly-mode-hint' role='status'>
+                Chuột (hoặc giữ chuột trái): nhìn · WASD: di chuyển · Q/E: xuống/lên · Shift: nhanh · Z/Esc: thoát
+            </div>
+        </>
+    );
+}
diff --git a/cvat-ui/src/components/annotation-page/canvas/views/canvas3d/isolate-points-button.tsx b/cvat-ui/src/components/annotation-page/canvas/views/canvas3d/isolate-points-button.tsx
